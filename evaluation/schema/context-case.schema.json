{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuliu.local/schema/context-case.schema.json",
  "title": "语流完整内容语境释义测试集",
  "type": "object",
  "required": ["dataset_id", "version", "documents"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "title", "file", "source_type", "cases"],
        "properties": {
          "document_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^documents/.+\\.html$" },
          "source_type": { "enum": ["synthetic_controlled", "real_public", "adversarial_variant"] },
          "source_url": { "type": "string", "format": "uri" },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri" }
          },
          "captured_at": { "type": "string", "format": "date" },
          "adaptation_note": { "type": "string", "minLength": 1 },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/case" }
          }
        },
        "allOf": [{
          "if": { "properties": { "source_type": { "const": "real_public" } }, "required": ["source_type"] },
          "then": {
            "required": ["captured_at", "adaptation_note"],
            "anyOf": [{ "required": ["source_url"] }, { "required": ["source_urls"] }]
          }
        }],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["case_id", "category", "difficulty", "selection", "expected", "evidence"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["basic", "contextual", "adversarial"] },
        "selection": {
          "type": "object",
          "required": ["exact", "anchor_block_id", "occurrence_index"],
          "properties": {
            "exact": { "type": "string", "minLength": 1 },
            "anchor_block_id": { "type": "string", "minLength": 1 },
            "occurrence_index": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "expected": {
          "type": "object",
          "required": ["sense", "referent_type", "maximum_specificity", "certainty", "allow_inference", "must_include_groups", "must_not_include", "reference_answer"],
          "properties": {
            "sense": { "type": "string", "minLength": 1 },
            "referent_type": { "enum": ["generic_concept", "organization", "product", "person", "method", "metric", "document_defined_term", "other"] },
            "maximum_specificity": { "enum": ["category", "named_entity", "exact_variant"] },
            "certainty": { "enum": ["clear", "inferred", "ambiguous", "insufficient"] },
            "allow_inference": { "type": "boolean" },
            "must_include_groups": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "must_not_include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "reference_answer": { "type": "string", "minLength": 1 },
            "author_intent_required": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["block_id", "quote", "role"],
            "properties": {
              "block_id": { "type": "string", "minLength": 1 },
              "quote": { "type": "string", "minLength": 1 },
              "role": { "enum": ["direct_support", "coreference_support", "structural_support", "sense_disambiguation", "author_intent_support"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
