{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuliu.local/schema/grounding-v2.schema.json",
  "title": "语流双通道语境释义输出 v2",
  "type": "object",
  "required": ["schema_version", "selected_text", "candidate_senses", "resolution", "meaning_here", "author_intent", "claims", "page_evidence", "external_sources", "notice_code"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "selected_text": { "type": "string", "minLength": 1 },
    "candidate_senses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sense_id", "label", "gloss", "referent_type", "supports"],
        "properties": {
          "sense_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "gloss": { "type": "string", "minLength": 1 },
          "referent_type": { "enum": ["generic_concept", "organization", "product", "person", "method", "metric", "document_defined_term", "other"] },
          "chinese_name": { "type": ["string", "null"] },
          "english_full_name": { "type": ["string", "null"] },
          "supports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/support" } }
        },
        "additionalProperties": false
      }
    },
    "resolution": {
      "type": "object",
      "required": ["status", "selected_sense_id", "alternative_sense_ids", "confidence", "specificity"],
      "properties": {
        "status": { "enum": ["clear", "inferred", "ambiguous", "insufficient", "unrecognized"] },
        "selected_sense_id": { "type": ["string", "null"] },
        "alternative_sense_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["high", "medium", "low"] },
        "specificity": { "enum": ["category", "named_entity", "exact_variant"] }
      },
      "additionalProperties": false
    },
    "meaning_here": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "chinese_name": { "type": ["string", "null"] },
        "english_full_name": { "type": ["string", "null"] },
        "contextual_role": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "author_intent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["text", "claim_ids"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "text", "supports"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim_type": { "enum": ["lexical_knowledge", "contextual_mapping", "author_intent", "high_risk_fact"] },
          "text": { "type": "string", "minLength": 1 },
          "supports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/support" } }
        },
        "additionalProperties": false
      }
    },
    "page_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "block_id", "quote", "role"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "block_id": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "role": { "enum": ["direct_support", "coreference_support", "structural_support", "sense_disambiguation", "author_intent_support"] }
        },
        "additionalProperties": false
      }
    },
    "external_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "url"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "publisher": { "type": ["string", "null"] },
          "excerpt": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "notice_code": { "enum": ["none", "multiple_senses", "insufficient_context", "term_unrecognized", "external_lookup_failed"] }
  },
  "$defs": {
    "support": {
      "type": "object",
      "required": ["source_kind"],
      "properties": {
        "source_kind": { "enum": ["model_knowledge", "page_evidence", "external_source"] },
        "source_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
